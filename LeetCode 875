class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int n = piles.length;
        int sum = 0;
        int min = 1;
        int max = Integer.MIN_VALUE;
        for(int i = 0; i < n; i++){
            if(piles[i] > max){
                max = piles[i];
            }
           
        }

        while(min <= max){
            int mid = min + (max - min)/ 2;
            long ptakr = check(n, piles, mid);
            if(ptakr <= h){
                sum = mid;
                max = mid -1;
            }else {
                min = mid +1;
            }
        }
        return sum;
    }
    long check(int n, int[] piles, int mid){
        long hours = 0;
        for(int i = 0; i < n; i++){
            hours += (piles[i] + mid - 1) / mid;
        }
        return hours;
        
    }
}
