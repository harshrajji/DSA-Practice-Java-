class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        int[] arr = new int[m];
        for(int i = 0; i < m; i++){
            arr[i] = nums1[i];
        }
        int k = 0,j = 0;
        for(int i = 0; i < m+n; i++){
            if(k == m && j <n){
                nums1[i] = nums2[j];
                if(j < n){
                    j++;
                }
            }else if(j == n && k < m){
                nums1[i] = arr[k];
                if(k < m){
                    k++;
                }
                
            }else if(arr[k] < nums2[j]){
                
                nums1[i] = arr[k];
                if(k < m){
                    k++;
                }
                
            }else{
                
                nums1[i] = nums2[j];
                if(j < n){
                    j++;
                }
                
            }
        }
    }
}
