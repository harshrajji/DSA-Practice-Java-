class Solution {
    public int[] concatWithReverse(int[] nums) {
        int[] ans = new int[2*nums.length];
        int k = 1;
        for(int i = 0; i < 2*nums.length; i++){
            if(i < nums.length){
                ans[i] = nums[i];
            }else{
                ans[i] = nums[nums.length - k];
                k++;
            }
        }
        return ans;
    }
}
