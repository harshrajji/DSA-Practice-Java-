public class Solution extends GuessGame {
    public int guessNumber(int n) {
        if(n == 1){
            return 1;
        }
        int start = 1;
        int end = n;
        while (start <= end) {// = lagana yaad dilaya gpt
            int num = start + (end - start) / 2;
            if (guess(num) == -1) {
                end = num -1;
            }else if (guess(num) == 1) {
                start = num +1;
            }else{
                return num;
            }
            
        }
        return 0;
        
    }
}
