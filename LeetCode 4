class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int m = nums1.length;
        int n = nums2.length;
        int[] arr = new int[m+n];
        int j = 0, k = 0;
        for(int i = 0; i < m+n; i++){
            if(k == m && j <n){
                arr[i] = nums2[j];
                if(j < n){
                    j++;
                }
            }else if(j == n && k < m){
                arr[i] = nums1[k];
                if(k < m){
                    k++;
                }
                
            }else if(nums1[k] < nums2[j]){
                
                arr[i] = nums1[k];
                if(k < m){
                    k++;
                }
                
            }else{
                
                arr[i] = nums2[j];
                if(j < n){
                    j++;
                }
                
            }
        }
        int s = 0;
        int e = (m+n) -1;
        int mid = s + (e -s) /2;
        if((m+n) % 2 != 0){
            return (double) arr[mid];
        }
        double sol = (double)(arr[mid] + arr[mid +1]) / 2;
        return sol;
    }
}
