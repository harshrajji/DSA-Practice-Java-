class Solution {
    public boolean search(int[] nums, int target) {
        int peak = peakIndexInMountainArray(nums);
        boolean ans = BinarySearch(nums, target, 0, peak);
        if (ans) {
            return ans;
        }else{
            boolean ans2 = BinarySearch(nums, target, peak+1, nums.length-1);
            return ans2;
        }
    }

    static int peakIndexInMountainArray(int [] nums){
        for(int i = 0; i < nums.length; i++){
            if(i < nums.length - 1 && nums[i] > nums[i +1]){
                return i;
            }
        }
        return 0;
        
    }

    static boolean BinarySearch(int[] nums, int target, int start, int end){
        
        while (start <= end) {
            int mid = start + (end - start) / 2;
            if (target < nums[mid]) {
                end = mid -1;
            }else if (target > nums[mid]) {
                start = mid +1;
            }else{
                return true;
            }
        }
        return false;
    }
}
