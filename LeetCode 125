class Solution {
    public boolean isPalindrome(String s) {
        s = s.toLowerCase();
        s = s.trim();
        int i = 0;
        int j = s.length() - 1;
        while(i < j){
            char ic = s.charAt(i);
            char jc = s.charAt(j);
            if(!(ic >= 'a' && ic <= 'z') && !(ic >= '0' && ic <= '9')){
                i++;
            }else if(!(jc >= 'a' && jc <= 'z') && !(jc >= '0' && jc <= '9')){
                j--;
            }else if(ic == jc){
                i++;
                j--;
            }else{
                return false;
            }
        }
        return true;
    }
}
