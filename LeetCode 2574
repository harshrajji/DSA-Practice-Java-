class Solution {
    public int[] leftRightDifference(int[] nums) {
        int n = nums.length;
        int [] leftsum = new int[n];
        int [] ritesum = new int[n];
        int sum = 0;
        for(int i = 0; i < n; i++){
            leftsum[i] = sum;
            sum += nums[i];
        }
        int sumr = 0;
        for(int i = n - 1; i >= 0; i--){
            ritesum[i] = sumr;
            sumr += nums[i];
        }
        int [] answ = new int[n];
        for(int i = 0; i < n; i++){
            answ[i] = Math.abs(leftsum[i] - ritesum[i]);
        }
        return answ;
    }
}
