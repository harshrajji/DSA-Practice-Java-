class Solution {
    public int[] productExceptSelf(int[] nums) {
        int[] ans = productwithoutSelf(nums);
        return ans;
    }

    int[] productwithoutSelf(int[] nums) {
        int n = nums.length;
        int[] answer = new int[n];
        int prod = 1;
        for(int i = 0; i < n; i++){
            if(i == 0){
                answer[i] = 1;
            }else{
                prod *= nums[i -1];
                answer[i] = prod;
            }
        }
        int prods = 1;
        for(int i = n-1; i >= 0; i--){
            if(i == n- 1){
                answer[i] *= 1;
            }else{
                prods *= nums[i +1];
                answer[i] *= prods;
            }
        }
        return answer;
    }
}
