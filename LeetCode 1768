class Solution {
    public String mergeAlternately(String word1, String word2) {
        int i = 0;
        int j = 0;
        int x = word1.length();
        int z = word2.length();
        StringBuilder sb = new StringBuilder();
        while(i < x || j < z){
            if(i < x){
                sb.append(word1.charAt(i));
                i++;
            }

            if(j < z){
                sb.append(word2.charAt(j));
                j++;
            }
        }
        String ans = new String(sb);
        return ans;
    }
}
