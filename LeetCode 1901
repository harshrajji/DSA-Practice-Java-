class Solution {
    public int[] findPeakGrid(int[][] mat) {
        int s = 0;
        int e = mat[0].length -1;
        while(s <= e){
            int mid = s + ( e - s ) / 2;
            int max = maco(mat, mid);
            if(mid != 0 && mid < mat[0].length -1){
                if(mat[max][mid] > mat[max][mid +1 ] && mat[max][mid] > mat[max][mid -1]){
                    return new int[] {max, mid};
                }else if(mat[max][mid] < mat[max][mid +1 ]){
                    s = mid+1;
                }else if(mat[max][mid] < mat[max][mid -1 ]){
                    e = mid-1;
                }
            }else if(mid == 0){
                if(mat[max][mid] > mat[max][mid +1 ]){
                    return new int[] {max, mid};
                }else{
                    s = mid+1;
                }
            }else if(mid == mat[0].length- 1){
                if( mat[max][mid] > mat[max][mid -1]){
                    return new int[] {max, mid};
                }else{
                    e = mid-1;
                }
            }

        }
        return new int[] {-1, -1};
    }

    int maco(int[][] mat, int mid){
        int maxo = 0;
        int maxi = 0;
        for(int i = 0; i < mat.length; i++){
            if(mat[i][mid] > maxo){
                maxo = mat[i][mid];
                maxi = i;
            }
        }
        return maxi;
    }
}
