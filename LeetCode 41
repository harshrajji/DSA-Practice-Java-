class Solution {
    public int firstMissingPositive(int[] nums) {
        int i = 0;
        while(i < nums.length){
            int correct = nums[i] -1;
            if (nums[i] > 0 && nums[i] < nums.length && nums[i] != nums[correct]) {
                swap(nums, i, correct);
            }else{
                i++;
            }
        }
        int count  = 1;
        for(int j = 0; j < nums.length; j++){
            if(nums[j] == count){
                count++;
            }
        }
        return count;
    }
    static void swap(int[] nums, int i, int correct){
        int temp = nums[i];
        nums[i] = nums[correct];
        nums[correct] = temp;
    }
}
