class Solution {
    public int[] sumZero(int n) {
        int [] sum = new int[n];
        int f = -(n/2);
        if(n % 2 == 0){
            for(int i = 0; i < n; i++){
                if(f == 0){
                    f++;
                }
                sum [i] = f;
                f++;
            }
            return sum;
        }else{
            for(int i = 0; i < n; i++){
                sum [i] = f;
                f++;
            }
            return sum;
        }
    }
}
