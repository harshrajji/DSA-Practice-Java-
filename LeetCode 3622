class Solution {
    public boolean checkDivisibility(int n) {
        int prod = 1;
        int sum = 0;
        int temp = n;
        while(temp > 0){
            int rem = temp % 10;
            sum += rem;
            prod *= rem;
            temp /= 10;
        }
        int divi = sum + prod;
        if(n % divi == 0){
            return true;
        }
        return false;
    }
}
