class Solution {
    public int removeDuplicates(int[] nums) {
        int count = 0;
        int n = nums.length;
        int [] expectednums = new int[n];
        for(int i = 0; i < n; i++){
            if(i > 0 && nums[i] == nums[i- 1]){
                expectednums[i] = 101;
                count++;
            }else{
                expectednums[i] = nums[i];
            }
        }

        int k = n - count;
        int [] output = new int[k];
        int ncount = 0;
        for (int i = 0; i < n; i++) {
            if (expectednums[i] == 101) {
                ncount++;
            }else{
                output[i - ncount] = expectednums[i];
            }
        
        }
        for(int i = 0; i < n; i++){
            if(i >= k){
                nums[i] = 0;
            }else{
                nums[i] = output[i];
            }
        }
        return k;

        
    }
}
