class Solution {
    public int smallestNumber(int n, int t) {
        while(n <= 100){
            int temp = n;
            int pd = 1;
            while(temp > 0){
                int dig = temp % 10;
                pd *= dig;
                temp /= 10;
            }
            if(pd % t == 0){
                return n;
            }else{
                n++;
            }
        }
        return n++;
    }
}
