class Solution {
    public String restoreString(String s, int[] ind) {
        int n = s.length();
        char[] arra = new char[n];

        char[] ans = new char[n];
        for (int i = 0; i < arra.length; i++) {
            ans[ind[i]] = arra[i];
        }
        String a = new String(ans);
        return a;
    }
}
