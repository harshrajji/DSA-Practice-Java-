class Solution {
    public int[] twoSum(int[] num, int tar) {
        HashMap<Integer, Integer> map = new HashMap<>();
        for(int i = 0; i < num.length; i++){
            int sec = tar - num[i];
            if (map.containsKey(sec)) {
                return new int[] {map.get(sec), i};
            }else{
                map.put(num[i], i);
            }
        }
        return new int[] {-1 -1};
    }
}
