class Solution {
    public int[] sortedSquares(int[] nums) {
        int l = nums.length;
        int s =0;
        int e = l -1;
        int[] ans = new int[l];
        for(int i = l -1; i >= 0; i--){
            long ss = (long) nums[s]*nums[s];
            long ee = (long) nums[e]*nums[e];
            if(ss > ee){
                ans[i] = (int)ss;
                s++;
            }else{
                ans[i] = (int)ee;
                e--;
            }
        }
        return ans;
    }
}
