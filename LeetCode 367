class Solution {
    public boolean isPerfectSquare(int num) {
        if(num == 1 || num == 4){
            return true;
        }
        if(num == 2147483647){
            return false;
        }
        long start = 1;
        long end = num/2;
        while (start <= end) {// = lagana yaad dilaya gpt
            long mid = start + (end - start) / 2;
            long sq = mid*mid;
            if (sq > num) {
                end = mid -1;
            }else if (sq < num) {
                start = mid + 1;
            }else{
                return true;
            }
        }
        return false;
    }
}
