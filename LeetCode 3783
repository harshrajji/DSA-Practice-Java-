class Solution {
    public int mirrorDistance(int n) {
        int temp = n;
        int nod = 0;
        while(temp > 0){
            temp = temp / 10;
            nod++;
        }
        temp = n;
        int refv = 0;
        while(temp > 0){
            int r = temp % 10;
            temp = temp / 10;
            int adder = add(r, nod);
            refv += adder;
            nod--;
        }
        int ans = Math.abs(n - refv);
        return ans;
    }
    static int add(int r, int nod){
        for(int i = 0; i < nod - 1; i++){
            r = r * 10;
        }
        return r;
    }
}
