class Solution {
    public int[] getSneakyNumbers(int[] nums) {
        int[] sol = new int[2];
        int k = 0;
        int[] count = new int[nums.length];
        for(int i : nums){
            count[i] += 1;
        }
        for(int i = 0; i < nums.length; i++){
            if(count[i]==2){
                sol[k] = i;
                k++;
            }
        }
        return sol;
    }
}
