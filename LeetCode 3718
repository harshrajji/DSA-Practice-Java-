class Solution {
    public int missingMultiple(int[] nums, int k) {
        int[] hai = new int[101];
        for(int nu : nums){
            hai[nu]++;
        }
        int i = 1;
        for(i = 1; i <= nums.length; i++){
            if(k*i < hai.length && hai[k * i] == 0){
                return k*i;
            }
            if(k*i >= hai.length){
                return k*i;
            }
        }
        return k * i;
    }
}
