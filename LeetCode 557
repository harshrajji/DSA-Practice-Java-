class Solution {
    public String reverseWords(String s) {
        char[] arr = s.toCharArray();
        int st = 0;
        for(int e = 0; e < arr.length; e++){
            if(arr[e] == ' '){
                reverse(arr, st, e-1);
                st = e+1;
            }
        }
        reverse(arr, st, arr.length - 1);
        String ans = new String(arr);
        return ans;
    }
    public void reverse(char[] arr, int s, int e){
        while(s < e){
            char te = arr[s];
            arr[s] = arr[e];
            arr[e] = te;
            s++;
            e--;
        }
    }
}
