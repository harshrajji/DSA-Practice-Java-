class Solution {
    public int romanToInt(String s) {
        int ans = 0;
        int len = s.length();
        int i = 0;
        while(i < len){
            if(i < len - 1){
                char c = s.charAt(i);
                char r = s.charAt(i + 1);
                int a = ptakr(c);
                int b = ptakr(r);
                if(b > a){
                    b = b - a;
                    ans += b;
                    i += 2;
                }else{
                    ans += a;
                    i++;
                }
            }else{
                char c = s.charAt(i);
                int a = ptakr(c);
                ans += a;
                i++;
            }
        }
        return ans;
    }
    static int ptakr(char c) {
        switch(c) {
            case 'I': return 1;
            case 'V': return 5;
            case 'X': return 10;
            case 'L': return 50;
            case 'C': return 100;
            case 'D': return 500;
            case 'M': return 1000;
        }
        return 0;
    }
}
