class Solution {
    public boolean isValid(String s) {
        int n = s.length();
        if(n % 2 != 0){
            return false;
        }
        StringBuilder sb = new StringBuilder();
        for(char c : s.toCharArray()){
            if(c == '(' || c == '[' || c == '{'){
                sb.append(c);
            }else{
                if(sb.length() > 0 ){
                    if(c == ')' && sb.charAt(sb.length()-1) == '('){
                        sb.deleteCharAt(sb.length() - 1);
                    }else if(c == ']' && sb.charAt(sb.length()-1) == '['){
                        sb.deleteCharAt(sb.length() - 1);
                    }else if(c == '}' && sb.charAt(sb.length()-1) == '{'){
                        sb.deleteCharAt(sb.length() - 1);
                    }else{
                        return false;
                    }
                }else{
                    return false;
                }      
            }
        }
        if(sb.length() == 0){
            return true;
        }
        return false;
    }
}
