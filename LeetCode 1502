class Solution {
    public boolean canMakeArithmeticProgression(int[] arr) {
        Arrays.sort(arr);
        int dif = arr[1] - arr[0];
        boolean[] check = new boolean[arr.length];
        for(int i = 0; i < arr.length-1; i++){
            if((arr[i+1] - arr[i]) == dif){
                check[i] = true;
            }else{
                return false;
            }
        }
        return true;
    }
}
