class Solution {
    public int findGCD(int[] nums) {
        int a = Integer.MAX_VALUE;
        int b = Integer.MIN_VALUE;
        for(int num : nums){
            if(num < a){
                a = num;
            }
            if(num > b){
                b = num;
            }
        }
        while(b % a != 0){
            int r = b % a;
            b = a;
            a = r;
        }
        return a;
    }
}
