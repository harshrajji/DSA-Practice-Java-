class Solution {
    public int maximumProduct(int[] nums) {
        Arrays.sort(nums);
        long ans = (long) nums[nums.length -1]*nums[nums.length -2]*nums[nums.length -3];
        long comp = (long) nums[0] *nums[1]*nums[nums.length -1];
        if(comp > ans){
            ans = comp;
        }
        return (int) ans;
    }
}
