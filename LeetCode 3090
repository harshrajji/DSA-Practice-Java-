class Solution {
    public int maximumLengthSubstring(String s) {
        int i = 0;
        int ans = 0;
        HashMap<Character, Integer> freq = new HashMap<>();
        for(int j = 0; j < s.length(); j++){
            char c = s.charAt(j);
            freq.put(c, freq.getOrDefault(c, 0) +1);
            while(freq.get(c) > 2){
                char m = s.charAt(i);
                freq.put(m, freq.get(m) -1);
                i++;
            }
            if(j - i + 1 > ans){
                ans = j - i + 1;
            }
        }
        return ans;
    }
}
