class Solution {
    public List<List<Integer>> minimumAbsDifference(int[] arr) {
        int n = arr.length;
        List<List<Integer>> ans = new ArrayList<>(n/2);
        int mindiff = Integer.MAX_VALUE;
        Arrays.sort(arr);
        for(int i = 1; i < n; i++){
            int dif = arr[i] - arr[i -1];
            if(dif < mindiff){
                mindiff = dif;
            }
        }
        for(int j = 1; j < n; j++){
            ArrayList<Integer> list = new ArrayList<>();
            int diff = arr[j] - arr[j -1];
            if(diff == mindiff){
                list.add(arr[j -1]);
                list.add(arr[j]);
                ans.add(list);
            }
        }
        return ans;
    }
}
