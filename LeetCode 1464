class Solution {
    public int maxProduct(int[] a) {
        int max = Integer.MIN_VALUE;
        int max2 = Integer.MIN_VALUE;
        for(int num : a){
            if(num > max){
                max2 = max;
                max = num;
            }else if(num > max2){
                max2 = num;
            }
        }
        int ans = (max-1)*(max2 -1);
        return ans;
    }

}
