class Solution {
    public double average(int[] a) {
        int deno = a.length -2;
        int max = Integer.MIN_VALUE;
        int min = Integer.MAX_VALUE;
        int sum = 0;
        for(int i : a){
            if(i > max){
                max = i;
            }
            if(i < min){
                min = i;
            }
            sum += i;
        }
        double ans = (double) (sum - (max + min)) / deno;
        return ans;
    }
}
