class Solution {
    public int repeatedStringMatch(String a, String b) {
        long lb = (b.length() + a.length() - 1) / a.length();
        int rep = 0;
        StringBuilder sb = new StringBuilder();
        for(int i = 0; i < lb; i++){
            sb.append(a);
            rep++;
        }
        if(!sb.toString().contains(b)){
            sb.append(a);
            rep++;
        }
        if(!sb.toString().contains(b)){
            return -1;
        }
        return rep;
    }
}
