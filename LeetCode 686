class Solution {
    public int repeatedStringMatch(String a, String b) {
        long lb = Math.max(b.length(), a.length());
        int rep = 0;
        StringBuilder sb = new StringBuilder();
        while (!sb.toString().contains(b) && sb.length() <= lb){
            sb.append(a);
            rep++;
        }
        if(!sb.toString().contains(b)){
            sb.append(a);
            rep++;
        }
        if(!sb.toString().contains(b)){
            return -1;
        }
        return rep;
    }
}
