class Solution {
    public int arithmeticTriplets(int[] nums, int diff) {
        int n = nums.length;
        int count = 0;
        for(int i = n-1; i > 1; i--){
            for(int j = i - 1; j > 0; j--){
                if(nums[i] - nums[j] != diff){
                    continue;
                }
                for(int k = j - 1; k >= 0; k--){
                    if(nums[j] - nums[k] != diff){
                        continue;
                    }else{
                        count++;
                    }
                }
            }
        }
        return count;
    }
}
