class Solution {
    public int[] findRightInterval(int[][] intervals) {
        int[] sol = new int[intervals.length];
        for(int i = 0; i < intervals.length; i++){
            int value = ansfun(intervals, -1, 0, Integer.MAX_VALUE, i);
            sol[i] = value;
        }
        return sol;

    }
    int ansfun(int[][] intervals, int ans, int right, int minright, int i){
        for(int j = 0; j < intervals.length; j++){
            if(intervals[j][0] >= intervals[i][1]){
                right = intervals[j][0];
                if(right < minright){
                    minright = right;
                    ans = j;
                }
            }
        }
        return ans;
    }
}
