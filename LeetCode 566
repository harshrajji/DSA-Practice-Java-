class Solution {
    public int[][] matrixReshape(int[][] mat, int r, int c) {
        int m = mat.length;
        int n = mat[0].length ;
        if(m*n != r*c){
            return mat;
        }
        int [][] reshape = new int[r][c];
        int ro = 0;
        int co = 0;
        int count = 0;
        for (int row = 0; row < r; row++){
            for (int col = 0; col < c; col++){
                if(co > n-1){
                   co = 0;
                   ro++;
                }
                reshape[row][col] = mat[ro][co];
                co++;
            }
            
        }
        return reshape;
    }
}
