class Solution {
    public int[] intersection(int[] nums1, int[] nums2) {
        
        HashSet<Integer> lu = new HashSet<>();
        for (int num : nums1) {
            lu.add(num);
        }
        
        HashSet<Integer> re = new HashSet<>();
        for (int num : nums2) {
            if (lu.contains(num)) {
                re.add(num);
            }
        }
        
        int [] ans = new int[re.size()];
        int i = 0;
        for (int num : re) {
            ans[i++] = num;
        }
        return ans;
        
        
        
