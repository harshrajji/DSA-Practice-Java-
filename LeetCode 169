class Solution {
    public int majorityElement(int[] nums) {
        int count = 0;
        int ind = 0;
        int maxcount = Integer.MIN_VALUE;
        Arrays.sort(nums);
        for(int i = 1; i < nums.length; i++){
            if(nums[i] == nums[i -1]){
                count++;
                if(count > maxcount){
                    maxcount = count;
                    ind = i;
                }
            }else{
                count = 0;
            }
        }
        return nums[ind];
    }
    
}
