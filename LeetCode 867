class Solution {
    public int[][] transpose(int[][] matrix) {
        int m = matrix.length;
        int n = matrix[0].length;
        int [][] tranp = new int [n][m];
        for (int i = 0; i < tranp.length; i++){
            for (int j = 0; j < tranp[i].length; j++){
                tranp[i][j] = matrix[j][i];
            }
        }
        return tranp;
    }
}
