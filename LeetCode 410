class Solution {
    public int splitArray(int[] nums, int k) {
        int s = Integer.MIN_VALUE;
        int e = 0;
        for (int i = 0; i < nums.length; i++) {
            if(nums[i] > s){
                s = nums[i];
            }
            e += nums[i];
        }

        while (s < e){
            int m = s + (e - s) / 2;
            int sum = 0;
            int piss = 1;
            for (int i : nums) {
                if (sum + i > m) {
                    sum = i;
                    piss++;
                }else{
                    sum += i;
                }
            }
            if (piss > k) {
                s = m + 1;
            }else{
                e = m;
            }
        }
        return s;
    }
}
