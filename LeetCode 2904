class Solution {
    public String shortestBeautifulSubstring(String s, int k) {
        int c = 0;
        int i = 0;
        int len = 0;
        int mi = 0;
        int mj = 0;
        int ml = Integer.MAX_VALUE;;
        for(int j = 0; j < s.length(); j++){
            char ch = s.charAt(j);
            if(ch == '1'){
                c++;
            }
            while(c >= k){
                if(s.charAt(i) == '0' && c >= k){
                    i++;
                }else if(s.charAt(i) == '1' && c > k){
                    c--;
                    i++;
                }else if(s.charAt(i) == '1' && c == k){
                    break;
                }
            }
            if(c == k){
                len = j - i + 1;
                if((len < ml || (len == ml && s.substring(i, j + 1).compareTo(s.substring(mi, mj + 1)) < 0))){
                    ml = len;
                    mi = i;
                    mj = j;
                }
            }
        }
        if(c == k){
            String ans = s.substring(mi, mj +1);
            return ans;
        }
        return "";
    }
}
