class Solution {
    public int[] plusOne(int[] digits) {
        int n = digits.length -1 ;
        int s = 0;
        if (digits[0] == 9 && digits[n] == 9 && digits[n/2] == 9){
            int [] result = new int[n+2];
            for(int i = n+1; i >= 0; i--){
                if(i > 0 && digits[i-1] == 9){
                    result[i] = 0;
                }else{
                    result[i] += 1;
                }
            }
            return result;
            
        }else if (digits[n] == 9 && digits[n-1] != 9){
            digits[n] = 0;
            digits[n-1] = digits[n-1] +1;
            return digits;
            
        }else if(digits[n] == 9){
            int [] result = new int[n+1];
            for(int i = n; i >= 0; i--){
                if(i > 0 && digits[i] == 9){
                    result[i] = 0;
                }else if(i == 0 && digits[i] == 9){
                    result[i] = digits[i];
                }else{
                    result[i] = digits[i] + 1;
                    s = i;
                    break;
                }
                
            }
            for(int i = 0; i < s; i++){
                result[i] = digits[i];
            }
            return result;
        }else{
            digits[n] += 1;
            return digits;
        }
    }
}
