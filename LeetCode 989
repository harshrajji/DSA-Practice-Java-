class Solution {
    public List<Integer> addToArrayForm(int[] nums, int k) {
        List<Integer> ans=new ArrayList<>();

        long num=0;
        int n=nums.length;
        int c=0;

        for(int i=n-1;i>=0;i--){
            int a=nums[i]+k%10+c;
            c=a/10;
            a=a%10;
            nums[i]=a;
            k/=10;
            if(k==0 && c==0) break;
        }
      
      if(c>0 && k==0) {
        ans.add(c);
        c=0;
      }
      if( k>0) {
        if(c>0) k+=c;
        String temp=String.valueOf(k);
          for(char t:temp.toCharArray()){
            ans.add(t-'0');
          }
        }
        for(int el:nums) ans.add(el);
          
        // if(c>0) ans.add(c);
        return ans;
    }
}
